knitr::opts_chunk$set(echo = TRUE)
here::i_am("tbi_rates.Rmd")
absolute_path_to_data <- here::here("raw_data.csv")
data <- read.csv(absolute_path_to_data, header = TRUE)
knitr::opts_chunk$set(echo = TRUE)
library(ggplot2)
knitr::opts_chunk$set(echo = TRUE)
library(ggplot2)
library(gt)
gt(data)
sum_table <- gt(data) |>
tab_header(title = "Rate of TBI (per 100,000) by sex, 2001-2010")
sum_table <- gt(data) |>
tab_header(title = "Rate of TBI (per 100,000) by sex, 2001-2010")
print(sum_table)
sum_table <- gt(data) |>
tab_header(title = "Rate of TBI (per 100,000) by sex, 2001-2010")
print(sum_table)
ggplot(data, aes(x= Year, y= Men, color = Men)) +
geom_line() +
geom_point()+
theme_classic()
#making a new column for sex and rate
ggplot(data, aes(x= Year)) +
geom_line(aes(y = Men, color = "Men")) +
geom_point(aes(y = Men, color = "Men")) +
geom_line(aes(y = Women, color = "Women")) +
geom_point(aes(y = Women, color = "Women")) +
theme_classic()
#making a new column for sex and rate
ggplot(data, aes(x= Year)) +
geom_line(aes(y = Men, color = "Men")) +
geom_point(aes(y = Men, color = "Men")) +
geom_line(aes(y = Women, color = "Women")) +
geom_point(aes(y = Women, color = "Women")) +
scale_x_continuous(breaks = 2001:2010) +
scale_y_continuous(limits = c(0, 1000)) +
theme_classic()
#making a new column for sex and rate
ggplot(data, aes(x= Year)) +
geom_line(aes(y = Men, color = "Men")) +
geom_point(aes(y = Men, color = "Men")) +
geom_line(aes(y = Women, color = "Women")) +
geom_point(aes(y = Women, color = "Women")) +
scale_x_continuous(breaks = 2001:2010) +
scale_y_continuous(limits = c(0, 1000)) +
labs(title = "Rates of TBI by sex, from 2001-2010",
x = "Year",
y = "Rate per 100,000 people",
color = "Sex") +
theme_classic()
knitr::opts_chunk$set(echo = TRUE)
library(ggplot2)
library(gt)
here::i_am("tbi_rates.Rmd")
absolute_path_to_data <- here::here("raw_data.csv")
data <- read.csv(absolute_path_to_data, header = TRUE)
sum_table <- gt(data) |>
tab_header(title = "Rate of TBI (per 100,000) by sex, 2001-2010")
print(sum_table)
#making a new column for sex and rate
ggplot(data, aes(x= Year)) +
geom_line(aes(y = Men, color = "Men")) +
geom_point(aes(y = Men, color = "Men")) +
geom_line(aes(y = Women, color = "Women")) +
geom_point(aes(y = Women, color = "Women")) +
scale_x_continuous(breaks = 2001:2010) +
scale_y_continuous(limits = c(0, 1000)) +
labs(title = "Rates of TBI by sex, from 2001-2010",
x = "Year",
y = "Rate per 100,000 people",
color = "Sex") +
theme_classic()
